<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <OutputType>Exe</OutputType>
        <ConvoyBuildDir Condition="'$(ConvoyBuildDir)' == ''">$(MSBuildThisFileDirectory)../../Convoy/bin/Release</ConvoyBuildDir>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="Convoy" HintPath="$(ConvoyBuildDir)/Convoy.dll" Private="false" />
        <Reference Include="BepInEx" HintPath="$(ConvoyBuildDir)/BepInEx.dll" Private="false" />
        <Reference Include="Newtonsoft.Json" HintPath="$(ConvoyBuildDir)/Newtonsoft.Json.dll" Private="false" />
        <Reference Include="System.Memory" HintPath="$(ConvoyBuildDir)/System.Memory.dll" Private="false" />
        <Reference Include="System.IO.Hashing" HintPath="$(ConvoyBuildDir)/System.IO.Hashing.dll" Private="false" />
    </ItemGroup>
</Project>
